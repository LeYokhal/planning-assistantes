# Copie ce fichier en .env pour le developpement local. Le .env n'est JAMAIS versionne.
# Genere une cle de developpement jetable (sans rapport avec celle de production) avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

DJANGO_SECRET_KEY=remplacer-par-une-cle-locale-jetable
DJANGO_DEBUG=1

# Hotes et origines autorises, separes par des virgules.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de donnees. Vide en local => SQLite (db.sqlite3).
# En production, Railway fournit DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=

# Adresse publique de l'application, utilisee pour construire les liens de connexion.
APP_URL=http://localhost:8000

# Webhook n8n charge d'envoyer les mails (voir docs/n8n/MAIL_SORTANT.md).
# Laisser vide en local : l'envoi est alors desactive (fail-closed), sans erreur.
N8N_MAIL_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Adresse du compte "cabinet" cree au pre-deploiement par assurer_compte_cabinet.
CABINET_EMAIL=

# Webhook n8n destinataire des evenements import.termine / import.echec
# (voir docs/n8n/IMPORT_PRESENCES.md). Vide = aucune notification (fail-closed).
# Le secret est celui de N8N_WEBHOOK_SECRET, envoye en en-tete X-Webhook-Secret.
N8N_IMPORT_WEBHOOK_URL=

# Secret de l'API entrante n8n -> application, en-tete X-Api-Secret.
# Vide = API desactivee (503). Chaine aleatoire d'au moins 32 caracteres.
N8N_API_SECRET=

# Endpoint "presences" du serveur MCP Doctolib : brique 0 non livree,
# LAISSER VIDE. Un tir endpoint aboutit alors en echec "endpoint inactif".
DOCTOLIB_PRESENCES_URL=
DOCTOLIB_PRESENCES_SECRET=

# Tirs endpoint en tache de fond. 1 = thread (defaut), 0 = synchrone (tests).
IMPORT_EN_ARRIERE_PLAN=1
